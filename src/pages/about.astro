---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, url } from '../data/site';

// Tools, grouped. Edit freely.
const tools = [
  { group: 'Languages', items: ['Python', 'TypeScript', 'JavaScript', 'C', 'C++', 'SQL', 'Solidity'] },
  { group: 'Front end', items: ['React', 'Next.js', 'Tailwind CSS', 'shadcn/ui', 'Framer Motion'] },
  { group: 'Back end', items: ['FastAPI', 'Django', 'Node.js', 'Express', 'REST APIs', 'JWT auth'] },
  { group: 'Data and AI', items: ['PostgreSQL', 'Supabase', 'MongoDB', 'Neo4j', 'LangChain', 'FAISS', 'spaCy'] },
  { group: 'Web3', items: ['Solidity', 'Hardhat', 'Ethers.js', 'Web3.js'] },
  { group: 'Shipping', items: ['Git', 'Docker', 'GitHub Actions', 'Vercel', 'pytest'] },
];

// Photography: every image in src/assets/photos/ shows up here automatically, sorted by file name.
// The file name doubles as the description, e.g. "02-marina-beach-at-dusk.jpg" -> "Marina beach at dusk".
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
    const words = name.replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ').trim();
    return { src: mod.default, alt: words ? words[0].toUpperCase() + words.slice(1) : 'Photograph' };
  });
---
<Base title="About" description="About Bhuvanesh S, a developer in Chennai who builds web apps, AI tools and smart contracts.">
  <section class="page-head">
    <div class="wrap">
      <h1>About</h1>
    </div>
  </section>

  <section class="section intro-sec">
    <div class="wrap intro">
      <img src={url(site.photo)} alt="Portrait of Bhuvanesh S" width="900" height="900" loading="eager" />
      <div class="bio">
        <p class="big">I make software. Usually the useful kind.</p>
        <p>
          I’m Bhuvanesh, and I live in Chennai, India. I’m the kind of person who has to know how something works before I can 
          leave it alone. Good for the work, bad for my sleep schedule.
        </p>
        <p>
        Outside of code I’m usually behind my phone taking pictures, or writing things down so I don’t forget them.
        </p>
        <p>
          If you’ve got something you want built, or just want to talk shop, <a class="text-link" href={`mailto:${site.email}`}>
          my inbox is open</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tools-title">Tools I reach for</h2>
        
      </div>
      <dl class="tools">
        {tools.map((t) => (
          <div>
            <dt>{t.group}</dt>
            <dd>{t.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" id="photography" aria-labelledby="photo-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="photo-title">Photography</h2>
        <p>{photos.length ? 'A small selection.' : 'A small selection, coming soon.'}</p>
      </div>
      <ul class="photos">
        {photos.length
          ? photos.map((p) => (
              <li>
                <a href={p.src.src} aria-label={`${p.alt}, full size`}>
                  <Image src={p.src} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" />
                </a>
              </li>
            ))
          : Array.from({ length: 6 }, () => <li><figure class="placeholder" data-label="Photo slot"></figure></li>)}
      </ul>
    </div>
  </section>

</Base>

<style>
  .intro-sec { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .intro { display: grid; gap: 2.5rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 52rem) { .intro { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); align-items: start; } }
  .intro img { width: 100%; height: auto; max-width: 24rem; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 6px; }
  .bio { display: grid; gap: 1.25rem; max-width: var(--measure); }
  .bio .big { font-size: var(--step-3); line-height: 1.1; font-weight: 600; font-variation-settings: 'opsz' 72, 'wdth' 85; letter-spacing: -0.02em; }
  .bio p:not(.big) { color: var(--paper); }

  .tools { margin: 0; border-top: 1px solid var(--rule); }
  .tools div { display: grid; gap: 0.25rem 2rem; grid-template-columns: minmax(0, 1fr); padding-block: 1.1rem; border-bottom: 1px solid var(--rule); }
  @media (min-width: 52rem) { .tools div { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); } }
  .tools dt { color: var(--muted); }
  .tools dd { margin: 0; }

  .photos { list-style: none; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .photos .placeholder, .photos img { aspect-ratio: 4 / 5; width: 100%; height: auto; object-fit: cover; border-radius: 6px; }
  .photos a { display: block; border-radius: 6px; }
  .photos img { transition: opacity 0.2s ease; }
  .photos a:hover img { opacity: 0.85; }

</style>
