---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';
import { url } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const project = projects.find((p) => p.slug === entry.data.slug)!;

const featured = projects.filter((p) => p.featured);
const i = featured.findIndex((p) => p.slug === project.slug);
const next = featured[(i + 1) % featured.length];
---
<Base title={entry.data.title} description={entry.data.lede}>
  <article>
    <header class="cs-head">
      <div class="wrap">
        <p class="back"><a href={url('work')}>Work</a></p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.lede}</p>

        <dl class="facts">
          <div><dt>Type</dt><dd>{project.kind}</dd></div>
          <div><dt>Role</dt><dd>{entry.data.role}</dd></div>
          <div><dt>Status</dt><dd><span class="status" data-status={project.status}>{project.status}</span></dd></div>
          <div>
            <dt>Links</dt>
            <dd class="links">
              {project.link && <a class="text-link" href={project.link.href}>{project.link.label}</a>}
              {project.repo && <a class="text-link" href={project.repo}>Source on GitHub</a>}
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="wrap">
      {entry.data.cover ? (
        <Image class="hero-shot shot" src={entry.data.cover} alt={entry.data.coverAlt ?? `Screenshot of ${project.name}`} widths={[800, 1280, 1920]} sizes="(min-width: 82rem) 76rem, 100vw" loading="eager" />
      ) : (
        <figure class="placeholder hero-shot" data-label={`Hero image: ${project.name}`}></figure>
      )}
      <div class="body prose">
        <Content />
      </div>
    </div>
  </article>

  {next && next.slug !== project.slug && (
    <aside class="next" aria-label="Next case study">
      <div class="wrap">
        <p>Next case study</p>
        <a href={url(`work/${next.slug}`)}>{next.name}</a>
      </div>
    </aside>
  )}
</Base>

<style>
  .cs-head { padding-block: clamp(2rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem); }
  .back { font-size: var(--step--1); color: var(--muted); }
  .back a { text-decoration: none; }
  .back a::before { content: '←'; margin-right: 0.4em; }
  .back a:hover { color: var(--print); }
  h1 {
    margin-top: 1rem;
    font-size: clamp(3rem, 11vw, 9rem); font-weight: 700;
    font-variation-settings: 'opsz' 96, 'wdth' 76; letter-spacing: -0.04em; line-height: 0.9;
  }
  .lede { margin-top: 1.75rem; font-size: var(--step-1); line-height: 1.4; max-width: 40rem; font-variation-settings: 'opsz' 30; }

  .facts {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    display: grid; gap: 1.25rem 2rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    border-top: 1px solid var(--rule); padding-top: 1.25rem;
  }
  .facts dt { color: var(--muted); font-size: var(--step--1); }
  .facts dd { margin: 0.3rem 0 0; font-size: 1rem; }
  .links { display: flex; flex-direction: column; gap: 0.2rem; }

  .hero-shot { aspect-ratio: 16 / 8; }
  .shot { width: 100%; height: auto; object-fit: cover; object-position: top; border-radius: 6px; border: 1px solid var(--rule); }
  .body { padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 9vw, 7rem); }

  .next { border-top: 1px solid var(--rule); padding-block: clamp(3rem, 7vw, 5rem); }
  .next p { color: var(--muted); font-size: var(--step--1); }
  .next a {
    display: inline-block; margin-top: 0.5rem;
    font-size: var(--step-4); font-weight: 650; font-variation-settings: 'opsz' 96, 'wdth' 80; letter-spacing: -0.025em;
    text-decoration: none;
  }
  .next a:hover { color: var(--print); }
</style>

<style is:global>
  /* Pull the section headings of a case study out into the left column on wide screens. */
  @media (min-width: 64rem) {
    .body.prose {
      max-width: none;
      display: grid; column-gap: 3rem;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
    .body.prose > * { grid-column: 2; max-width: var(--measure); }
    .body.prose > figure.placeholder, .body.prose > p:has(> img:only-child) { max-width: none; }
    .body.prose > h2 { grid-column: 1; margin-top: 2.6rem; }
    .body.prose > h2 + * { margin-top: 2.6rem; }
    .body.prose > h2:first-child, .body.prose > h2:first-child + * { margin-top: 1.5rem; }
  }
</style>
