---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';
---
<Base title="Page not found">
  <section class="page-head">
    <div class="wrap">
      <h1>Not found</h1>
      <p>This page doesn’t exist, or it moved. Try the <a class="text-link" href={url()}>home page</a> or the <a class="text-link" href={url('work')}>list of projects</a>.</p>
    </div>
  </section>
  <div style="height: 6rem"></div>
</Base>
