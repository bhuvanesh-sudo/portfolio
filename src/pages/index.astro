---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import ToolsPanel from '../components/ToolsPanel.astro';
import { projects, others } from '../data/projects';
import { work, servicesHead, processHead, toolsHead, statement, about } from '../data/home';
import { url } from '../data/site';

const shortList = others.slice(0, 4);
const a = (p: string) => url(`assets/${p}`);
---
<Base home>
  <Fragment slot="head">
    <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
    <link rel="modulepreload" href={a('moments/moments.js')} />
    <link rel="modulepreload" href={a('moments/lib.js')} />
    <link rel="modulepreload" href={a('moments/word-highlight/moment.js')} />
  </Fragment>

  <Hero />

  <section class="section" id="work" style="--hm: 2" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-h">{work.title} <span class="muted">{work.lead}</span></h2>
      </div>
      <FeaturedWork />
    </div>
  </section>

  <section class="section" id="services" style="--hm: 2" aria-labelledby="services-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-h">{servicesHead.title} <span class="muted">{servicesHead.lead}</span></h2>
      </div>
      <Services />
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-h">{processHead.title} <span class="muted">{processHead.lead}</span></h2>
      </div>
      <Process />
    </div>
  </section>

  <section class="section statement" id="approach" data-moment="word-highlight" aria-label="Approach">
    <div class="wrap">
      <p class="t-label">Approach</p>
      <p class="mo-wh__text">{statement.before} <strong>{statement.strong}</strong>{statement.after}</p>
    </div>
  </section>

  <section class="section" id="projects" style="--hm: 2" aria-labelledby="more-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="more-h">{toolsHead.title} <span class="muted">{toolsHead.lead}</span></h2>
      </div>
      <div class="grid more-grid">
        <div class="span-7">
          <ProjectIndex items={shortList} />
          <p class="more"><a class="link" href={url('work')}>See all {projects.length} projects</a></p>
        </div>
        <div class="span-5 start-8"><ToolsPanel /></div>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="about-h">{about.title}. <span class="muted">Student and builder in Chennai.</span></h2>
      </div>
      <AboutTeaser />
    </div>
  </section>
</Base>

<style>
  .more { margin-top: var(--s-4); }
  /* from 640 to 1279 the cards stack two-up and this section holds two screens */
  @media (min-width: 640px) and (max-width: 1279px) { #services { --h: 2; } }
  .more-grid { align-items: stretch; }
  /* a fourth project fills the phone's two screens; wider layouts show three */
  @media (min-width: 640px) { .more-grid :global(.index .row:nth-child(4)) { display: none; } }
</style>
