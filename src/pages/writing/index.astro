---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../data/site';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Writing" description="Notes by Bhuvanesh S on building software and what breaks along the way.">
  <section class="page-head">
    <div class="wrap">
      <h1>Writing</h1>
      <p>Notes on what I’m building, what I’m learning, and what broke along the way.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {posts.length ? (
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
              <div>
                <h2><a href={url(`writing/${p.id}`)}>{p.data.title}</a></h2>
                <p>{p.data.summary}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>Nothing published yet. The first posts are being written now.</p>
          <p>In the meantime, the <a class="text-link" href={url('work')}>case studies</a> are the closest thing to long-form here.</p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .posts { list-style: none; border-top: 1px solid var(--rule); }
  .posts li {
    position: relative;
    display: grid; gap: 0.5rem 2rem; grid-template-columns: minmax(0, 1fr);
    padding-block: 1.75rem; border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 52rem) { .posts li { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); align-items: baseline; } }
  time { color: var(--muted); font-size: var(--step--1); }
  h2 { font-size: var(--step-2); font-variation-settings: 'opsz' 72, 'wdth' 88; letter-spacing: -0.015em; }
  h2 a { text-decoration: none; }
  h2 a::after { content: ''; position: absolute; inset: 0; }
  li:hover h2 a { color: var(--print); }
  .posts p { margin-top: 0.5rem; color: var(--muted); max-width: 36rem; }
  .empty { border: 1px dashed var(--rule); border-radius: 6px; padding: clamp(1.5rem, 4vw, 2.5rem); max-width: 40rem; }
  .empty p + p { margin-top: 0.75rem; color: var(--muted); }
</style>
