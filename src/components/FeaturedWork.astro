---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { featured } from '../data/projects';
import { featuredTitles } from '../data/home';
import { url } from '../data/site';

const studies = await getCollection('work');
// A project without a cover shows a screenshot slot: add `cover` to its file in src/content/work/.
const coverFor = (slug: string) => studies.find((s) => s.data.slug === slug)?.data;
---
<div class="grid">
  {featured.map((p) => {
    const cover = coverFor(p.slug);
    return (
      <article class="card card--row card--open span-6">
        <h3>{featuredTitles[p.slug] ?? p.name}</h3>
        <p>{p.summary}</p>
        <p class="t-small muted">{p.stack.join(', ')}</p>
        <div class="panel work-panel">
          {cover?.cover ? (
            <Image class="frame__img" src={cover.cover} alt={cover.coverAlt ?? `Screenshot of ${p.name}`} widths={[640, 960, 1280]} sizes="(min-width: 64rem) 40vw, 640px" />
          ) : (
            <figure class="placeholder" data-label={`Screenshot: ${p.name}`}></figure>
          )}
        </div>
        <p class="work-links">
          <a class="link" href={url(`work/${p.slug}`)}>Read the case study<span class="visually-hidden"> for {p.name}</span></a>
          {p.link && <a class="link" href={p.link.href}>{p.link.label}<span class="visually-hidden"> for {p.name}</span></a>}
          {p.repo && <a class="link" href={p.repo}>Source on GitHub<span class="visually-hidden"> for {p.name}</span></a>}
        </p>
      </article>
    );
  })}
</div>

<style>
  .work-panel { --p-h: 300px; overflow: hidden; }
  .work-panel :global(.frame__img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .work-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  @media (max-width: 639px) { .work-links { justify-content: space-between; } }
  @media (max-width: 639px) { .work-panel { --p-h: 400px; } }
</style>
