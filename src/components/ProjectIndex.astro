---
import type { Project } from '../data/projects';
import { url } from '../data/site';

interface Props { items: Project[] }
const { items } = Astro.props;

const hrefFor = (p: Project) =>
  p.featured ? url(`work/${p.slug}`) : p.link?.href ?? p.repo;
const actionFor = (p: Project) =>
  p.featured ? 'Case study' : p.link ? p.link.label : p.repo ? 'Source' : 'Not public yet';
---
<ul class="index">
  {items.map((p) => {
    const href = hrefFor(p);
    return (
      <li class="row">
        <div class="name">
          <h3>{href ? <a href={href}>{p.name}</a> : p.name}</h3>
          <p class="kind">{p.kind}{p.team && ', team project'}</p>
        </div>
        <p class="summary">{p.summary}</p>
        <div class="side">
          <span class="status" data-status={p.status}>{p.status}</span>
          <span class="action">{actionFor(p)}</span>
        </div>
      </li>
    );
  })}
</ul>

<style>
  .index { list-style: none; border-top: 1px solid var(--rule); }
  .row {
    position: relative;
    display: grid; gap: 0.5rem 2rem;
    grid-template-columns: minmax(0, 1fr);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 52rem) {
    .row { grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2fr); align-items: baseline; }
    .side { flex-direction: column; align-items: flex-end; }
  }
  h3 { font-size: var(--step-1); font-variation-settings: 'opsz' 40, 'wdth' 90; letter-spacing: -0.01em; }
  h3 a { text-decoration: none; }
  /* Whole row is clickable via the title link. */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .row:has(a):hover { background: linear-gradient(90deg, rgba(122, 174, 255, 0.06), transparent 70%); }
  .row:has(a):hover h3 a { color: var(--print); }
  .kind { color: var(--muted); font-size: var(--step--1); margin-top: 0.3rem; }
  .summary { color: var(--paper); max-width: 36rem; }
  .side { display: flex; gap: 0.35rem 1.25rem; flex-wrap: wrap; font-size: var(--step--1); color: var(--muted); }
  .action { color: var(--muted); }
  .row:has(a):hover .action { color: var(--print); }
</style>
