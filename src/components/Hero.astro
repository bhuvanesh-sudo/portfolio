---
// The dealt hero (centred): notice pill, h1, lead, two buttons, then one window holding the TypeFaze
// pipeline diagram. The window is the page's visual; it enters once on load (data-enter) and then rests
// apart from the diagram's own pulse.
import TypeFazeDiagram from './TypeFazeDiagram.astro';
import { hero } from '../data/home';
import { url } from '../data/site';
---
<section class="hero hero--centred" data-enter aria-labelledby="hero-h">
  <div class="wrap"><div class="hero-text">
    <div class="hero__c">
      <a class="pill" href={url('work/typefaze')}><span>{hero.notice}</span></a>
      <h1 id="hero-h">{hero.h1}</h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="btn btn--secondary" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
    </div>
    <div class="hero__window">
      <div class="ly-piece ui ui-panel hw">
        <div class="hw__bar">
          <span class="ui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="hw__crumb">TypeFaze <i>/</i> <b>runs in your browser</b></span>
        </div>
        <div class="hw__body"><TypeFazeDiagram /></div>
      </div>
    </div>
  </div></div>
</section>

<style>
  /* the frame's lit ground: the page's bronze rising from the foot, flat colour only */
  .hero__window {
    --ground-bg: radial-gradient(120% 90% at 50% 125%, color-mix(in oklab, var(--accent) 38%, var(--p-bg)) 0, var(--p-bg) 62%);
  }
  .hero__c :global(.hero__lead) { color: color-mix(in oklab, var(--p-ink) 86%, var(--p-bg)); }
  @media (max-width: 639px) { .hero__c :global(.pill) { width: 100%; justify-content: center; } }
  .hw {
    overflow: hidden; background: var(--p-surface);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--p-ink) 14%, transparent), 0 30px 70px -30px rgb(0 0 0 / .8);
  }
  .hw__bar {
    display: flex; align-items: center; gap: 14px; height: 44px; padding: 0 14px;
    border-bottom: 1px solid color-mix(in oklab, var(--p-ink) 12%, transparent);
    font-size: 13px; line-height: 16px; color: var(--p-muted);
  }
  .hw .ui-dots { display: inline-flex; gap: 6px; }
  .hw .ui-dots i { width: 10px; height: 10px; border-radius: 50%; background: color-mix(in oklab, var(--p-ink) 22%, transparent); }
  .hw__crumb i { font-style: normal; }
  .hw__crumb b { font-weight: 500; color: var(--p-ink); }
  .hw__body { height: 232px; padding: var(--s-3) var(--s-4); }
  .hw__body :global(.dg) { height: 100%; }
  @media (max-width: 639px) { .hw__body { height: 180px; padding: var(--s-2); } }
</style>
