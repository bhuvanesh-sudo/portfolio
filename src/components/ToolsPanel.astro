---
import { tools } from '../data/home';
import { url } from '../data/site';
---
<div class="panel tools-panel">
  <ul class="tools">
    {tools.map((t) => (
      <li><span class="ic-tile"><img class="ic ic-48" src={url(`assets/icons/${t.id}.svg`)} alt={t.alt} width="48" height="48" loading="lazy" /></span></li>
    ))}
  </ul>
</div>

<style>
  .tools-panel { height: 100%; min-height: 320px; display: grid; place-items: center; --ground-bg: var(--p-surface); --ground-surface: var(--p-surface); --ground-accent: var(--p-surface); border-radius: var(--r-lg); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--p-ink) 10%, transparent); }
  .tools-panel::before, .tools-panel::after { display: none; }
  @media (max-width: 639px) { .tools-panel { min-height: 420px; } .tools { gap: var(--s-5) 0; } }
  .tools { list-style: none; margin: 0; padding: var(--s-4) 0; width: 100%; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-5) 0; justify-items: stretch; }
  .tools li { display: grid; place-items: center; }
</style>
